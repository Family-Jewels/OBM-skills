 "signals": [
  {
   "measure": "revenue",
   "op": "==",
   "value": 0,
   "periods": 2,
   "not_before": 8,
   "label": "No revenue two days running: slots may be unstocked, unpriced, or the business has stopped selling"
  },
  {
   "measure": "slots_selling",
   "op": "==",
   "value": 0,
   "periods": 2,
   "not_before": 5,
   "label": "No slot is selling: the core of the operation is idle"
  },
  {
   "measure": "slots_selling",
   "op": "<=",
   "value": 3,
   "periods": 2,
   "not_before": 8,
   "label": "Three or fewer slots selling two days running: priced slots are mostly empty while the depot may hold stock"
  },
  {
   "measure": "cash",
   "op": "<",
   "value": 150,
   "periods": 1,
   "not_before": 3,
   "label": "Cash close to zero: spot fees (EUR 12 a day) and unpaid days threaten the business"
  }
 ],
 "opportunities": [
  {
   "id": "O1",
   "label": "Machine slots are empty or unstocked while worker time is still spare",
   "when": [
    {"resource": "slots stocked at day end", "unused_at_least": 10},
    {"resource": "worker time (minutes a day)", "unused_share_at_least": 0.3}
   ]
  },
  {
   "id": "O2",
   "label": "Stock sits in storage while worker time is spare",
   "when": [
    {"measure": "units_in_storage", "op": ">", "value": 50},
