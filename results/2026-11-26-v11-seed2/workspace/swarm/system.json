 ],
 "signals": [
  {"measure": "slots_selling", "op": "==", "value": 0, "periods": 2, "not_before": 8,
   "label": "no slot is selling: machines are empty or unpriced"},
  {"measure": "revenue", "op": "==", "value": 0, "periods": 3, "not_before": 8,
   "label": "no sales for three periods: the network is not earning"},
  {"measure": "cash", "op": "<", "value": 100, "periods": 1, "not_before": 3,
   "label": "cash is close to the daily spot fee and stock costs; arrears would end the business after ten unpaid days"}
 ],
 "opportunities": [
  {"id": "O1",
   "label": "Empty slots and worker time left at day end: stock or reprice slots that can earn",
   "when": [
    {"resource": "slots stocked at day end", "unused_at_least": 1},
    {"resource": "worker time (minutes a day)", "unused_share_at_least": 0.3}
   ]},
  {"id": "O2",
   "label": "Stock sits in the depot while slots are empty",
   "when": [
    {"measure": "units_in_storage", "op": ">", "value": 0},
    {"resource": "slots stocked at day end", "unused_at_least": 1}
   ]},
  {"id": "O3",
   "label": "Cash is available to spend and worker time is unused: stock or reprice slots that can earn, after loading stock already waiting in the depot",
   "when": [
    {"resource": "worker time (minutes a day)", "unused_share_at_least": 0.3},
    {"measure": "cash", "op": ">", "value": 500}
   ]},
  {"id": "O4",
   "label": "Stocked slots are empty and the depot holds no stock: the next order is what fills them",
   "when": [
    {"resource": "slots stocked at day end", "unused_at_least": 1},
    {"measure": "units_in_storage", "op": "==", "value": 0}
   ]}
 ],
